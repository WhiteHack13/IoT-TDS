        "id": "func_estado",
        "type": "function",
        "z": "b1a1c2c3d4e5f6",
        "name": "Procesar estado LAMP",
        "func": "let txt = msg.payload.trim();\nif (txt.includes(\"LAMP:ON\")) {\n    node.status({fill:\"green\",shape:\"dot\",text:\"Lámpara encendida\"});\n} else if (txt.includes(\"LAMP:OFF\")) {\n    node.status({fill:\"red\",shape:\"ring\",text:\"Lámpara apagada\"});\n}\nreturn msg;",
