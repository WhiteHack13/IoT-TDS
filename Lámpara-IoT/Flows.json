    {
        "id": "func_command",
        "type": "function",
        "z": "b1a1c2c3d4e5f6",
        "name": "Procesar comando",
        "func": "// Asegura que el payload sea un objeto JSON válido\nlet data = {};\n\nif (typeof msg.payload === \"string\") {\n    try {\n        data = JSON.parse(msg.payload);\n    } catch (e) {\n        node.warn(\"Error al parsear JSON: \" + msg.payload);\n        data = {};\n    }\n} else if (typeof msg.payload === \"object\") {\n    data = msg.payload;\n}\n\nlet cmd = (data.cmd || \"\").toUpperCase();\nnode.warn(\"Comando recibido desde la web: \" + cmd);\n\nif (cmd === \"ON\") {\n    msg.payload = \"ON\\n\";\n} else if (cmd === \"OFF\") {\n    msg.payload = \"OFF\\n\";\n} else if (cmd === \"AUTO\") {\n    msg.payload = \"AUTO\\n\";\n} else {\n    msg.payload = \"\";\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 120,
